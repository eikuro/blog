---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

type Post = CollectionEntry<'posts'>;

const posts = (await getCollection('posts')).sort(
  (first: Post, second: Post) => second.data.date.valueOf() - first.data.date.valueOf(),
);
---

<BaseLayout
  title="Engineering notes"
  description="Engineering notes about the systems, tools, and decisions behind Aurora."
>
  <section class="intro">
    <p class="eyebrow">Field notes / 001</p>
    <h1>Small systems,<br /><em>carefully made.</em></h1>
    <p class="intro-copy">
      A running record of the choices behind Aurora: its repositories, tooling,
      and the quiet machinery that keeps them moving together.
    </p>
  </section>

  <section class="archive" aria-labelledby="archive-heading">
    <div class="archive-heading">
      <p class="eyebrow">Archive</p>
      <h2 id="archive-heading">Recent writing</h2>
    </div>
    <div class="post-list">
      {
        posts.map((post: Post, index: number) => (
          <a class="post-card" href={`${import.meta.env.BASE_URL}/posts/${post.id}/`}>
            <span class="post-number">{String(index + 1).padStart(2, '0')}</span>
            <span class="post-copy">
              <span class="post-meta">
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('en-GB', {
                    day: '2-digit',
                    month: 'short',
                    year: 'numeric',
                  })}
                </time>
                <span>·</span>
                <span>{post.data.type}</span>
              </span>
              <strong>{post.data.name}</strong>
              <span class="post-description">{post.data.description}</span>
            </span>
            <span class="post-arrow" aria-hidden="true">↗</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    max-width: 680px;
    padding: clamp(56px, 8vw, 96px) 0 80px;
  }

  .eyebrow {
    margin: 0 0 16px;
    text-transform: uppercase;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 20px;
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 500;
    line-height: 1.1;
  }

  h1 em {
    color: var(--signal);
    font-style: normal;
  }

  .intro-copy {
    max-width: 550px;
    margin-bottom: 0;
    color: var(--muted);
    font-size: 17px;
  }

  .archive {
    display: grid;
    grid-template-columns: 176px 1fr;
    gap: 40px;
    padding-bottom: 80px;
  }

  h2 {
    margin-bottom: 0;
    font-size: 18px;
    font-weight: 600;
  }

  .post-list {
    border-top: 1px solid var(--line);
  }

  .post-card {
    display: grid;
    grid-template-columns: 36px 1fr 20px;
    gap: 16px;
    align-items: start;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: color 160ms ease;
  }

  .post-card:hover,
  .post-card:focus-visible {
    color: var(--signal);
  }

  .post-number {
    color: var(--muted);
    font-family: 'DM Mono', monospace;
    font-size: 11px;
  }

  .post-copy > * {
    display: block;
  }

  .post-meta {
    display: flex !important;
    gap: 8px;
    margin-bottom: 8px;
  }

  .post-card strong {
    margin-bottom: 8px;
    font-size: 16px;
    font-weight: 600;
  }

  .post-description {
    color: var(--muted);
    font-size: 14px;
  }

  .post-arrow {
    font-family: 'DM Mono', monospace;
    font-size: 16px;
    text-align: right;
  }

  @media (max-width: 720px) {
    .intro {
      padding-bottom: 64px;
    }

    .archive {
      display: block;
      padding-bottom: 64px;
    }

    .archive-heading {
      margin-bottom: 20px;
    }
  }
</style>
