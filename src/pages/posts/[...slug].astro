---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

type Post = CollectionEntry<'posts'>;

export async function getStaticPaths() {
  const posts = await getCollection('posts');

  return Promise.all(
    posts.map(async (post: Post) => ({
      params: { slug: post.id },
      props: { post, rendered: await render(post) },
    })),
  );
}

const { post, rendered } = Astro.props;
const { Content } = rendered;
---

<BaseLayout title={post.data.name} description={post.data.description}>
  <article class="post">
    <a class="back-link" href={`${import.meta.env.BASE_URL}`}>← All notes</a>
    <header class="post-header">
      <p class="eyebrow">{post.data.type}</p>
      <h1>{post.data.name}</h1>
      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('en-GB', {
            day: '2-digit',
            month: 'long',
            year: 'numeric',
          })}
        </time>
        <span>{post.data.description}</span>
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 720px;
    padding: 56px 0 96px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 56px;
    color: var(--muted);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    text-decoration: none;
  }

  .back-link:hover,
  .back-link:focus-visible {
    color: var(--signal);
  }

  .eyebrow {
    color: var(--signal);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    text-transform: uppercase;
  }

  h1 {
    max-width: 680px;
    margin: 0 0 20px;
    font-size: clamp(36px, 6vw, 56px);
    font-weight: 500;
    line-height: 1.15;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    color: var(--muted);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
  }

  .post-header {
    padding-bottom: 40px;
    border-bottom: 1px solid var(--line);
  }

  .prose {
    padding-top: 40px;
    font-size: 16px;
  }

  .prose :global(h1) {
    display: none;
  }

  .prose :global(h2) {
    margin: 48px 0 16px;
    font-size: 24px;
    font-weight: 500;
    line-height: 1.25;
  }

  .prose :global(h3) {
    margin: 32px 0 12px;
    font-size: 18px;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 20px;
  }

  .prose :global(a) {
    color: var(--signal);
  }

  .prose :global(code) {
    padding: 2px 4px;
    background: var(--paper-deep);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.85em;
  }

  .prose :global(pre) {
    overflow-x: auto;
    margin: 28px 0;
    padding: 16px;
    background: var(--ink);
    color: var(--paper);
  }

  .prose :global(pre code) {
    padding: 0;
    background: transparent;
  }

  .prose :global(blockquote) {
    margin: 28px 0;
    padding-left: 20px;
    border-left: 2px solid var(--signal);
    color: var(--muted);
  }

  .prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
  }

  @media (max-width: 640px) {
    .post {
      padding-top: 40px;
    }

    .back-link {
      margin-bottom: 40px;
    }
  }
</style>
